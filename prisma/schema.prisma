// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Admin panel (Plan Phase A). Enums, not plain strings like `themeMode`/
// `year` below — role/status gate access to *other people's* data, so a
// typo here is a security bug, not just a display glitch. There is no API
// route that sets `role` on a not-yet-admin account (see
// scripts/grant-admin.mjs) — self-service privilege escalation is the one
// thing this model is deliberately unable to express.
enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  gender       Gender        @default(OTHER)
  themeMode    String        @default("light") // "light" | "dark"
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)

  // Professional details (Profile page) — this app is built for medical/
  // dental UG and PG students specifically, not a generic "user"; these are
  // all optional since they're collected after signup, not during it.
  specialization String? // e.g. "General Medicine", "Dentistry"
  institute      String? // hospital/college name
  studentType    String? // "UG" | "PG" — which year options apply
  year           String? // e.g. "1st Year" .. "Final Year", "Internship"
  phone          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients      Patient[]
  refreshTokens RefreshToken[]
}

// Admin panel (Plan Phase B) — a record of every destructive/consequential
// admin action, since these touch other people's accounts and real patient
// data. Deliberately has NO foreign-key relations to User: an audit log
// that cascade-deletes when its subject (or actor) is removed defeats its
// own purpose, so admin/target identity is captured as plain denormalized
// fields (id + email, snapshotted at the time of the action) instead.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  adminEmail   String
  action       String // "SUSPEND" | "REACTIVATE" | "FORCE_LOGOUT" | "ROLE_CHANGE" | "DELETE_USER"
  targetUserId String
  targetEmail  String
  detail       String?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([adminId])
}

// Signup is now a 3-step email-verification flow (start -> verify-otp ->
// complete): no User row exists until the OTP is verified and a password is
// set, so the pending state lives here instead. Keyed by email so a repeat
// "start" (resend) just overwrites the previous OTP; the row is deleted the
// moment verify-otp succeeds (see app/api/auth/signup/verify-otp/route.ts).
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  gender       Gender
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Forgot-password mirrors signup's OTP flow (start -> verify-otp ->
// complete), same table shape as PendingSignup but keyed to an existing
// User instead of a not-yet-created one. Deleted the moment its OTP is
// verified — same one-time-use guarantee.
model PasswordReset {
  id           String   @id @default(cuid())
  email        String   @unique
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A Patient belongs to exactly one PG user (their own patient list).
// Same real-world patient visiting a different PG user again = a separate Patient row
// for that PG user, by design — each user's list is independent.
model Patient {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  age     Int?
  opdNo   String
  phone   String?
  email   String?
  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  // One OPD No. can't belong to two different Patient rows for the same
  // user — a repeat OPD No. means "add a visit to the existing patient"
  // (POST .../appointments), never "create a second patient" (Reference J).
  // Enforced both here (hard guarantee) and with a friendly pre-check in
  // POST /api/patients (app/api/patients/route.ts) that returns which
  // existing patient it collided with, rather than a raw constraint error.
  @@unique([userId, opdNo])
  @@index([userId, name])
}

// Every visit = a new Appointment row. Nothing here overwrites a previous one.
model Appointment {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentDate DateTime
  ocrRawText      String? // optional: keep raw OCR text for later debugging/re-parsing
  // (the prescription image itself is never stored anywhere)
  notes           String?

  createdAt DateTime @default(now())

  @@index([patientId])
}
